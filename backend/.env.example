# Copy this file to .env and adjust as needed. Never commit real secrets.

# Local dev (default): SQLite, zero setup.
DATABASE_URL=sqlite:///./civicfix.db
# Production (Render/PostgreSQL) — same SQLAlchemy models, no code changes
# needed. Requires the psycopg driver (already in requirements.txt).
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/civicfix
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=480

# Issue understanding (app/services/issue_understanding_service.py).
# AI_PROVIDER=mock / VLM_PROVIDER=none use the deterministic built-in
# keyword classifier — no API key needed, and the report pipeline never
# breaks because a provider is unavailable. Set AI_PROVIDER=groq for text
# understanding and/or VLM_PROVIDER=groq for image understanding (both use
# the same Groq account, just different models) to route through an LLM;
# any failure there falls back to the deterministic path automatically.
AI_PROVIDER=mock
VLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VLM_MODEL=llama-3.2-11b-vision-preview
GROQ_TIMEOUT_SECONDS=8

# Voice accessibility: text-to-speech (app/services/tts_service.py).
# TTS_PROVIDER=browser (default) means the backend never calls out at all —
# the frontend speaks guidance via window.speechSynthesis instead, which
# works fully offline where the browser supports it. Set TTS_PROVIDER=
# elevenlabs + the vars below to proxy real ElevenLabs audio through the
# backend; ELEVENLABS_API_KEY must NEVER be exposed to the frontend (no
# VITE_ prefix — it is only read here, server-side).
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_SECONDS=8

# Local dev (default). For Render's persistent disk in production, mount
# it and point here instead, e.g. UPLOAD_DIR=/var/data/uploads — only the
# sanitized/re-encoded output is ever written under this path (see
# app/services/image_sanitizer.py); raw uploads are never stored.
UPLOAD_DIR=./uploads

# Image upload security (app/services/image_sanitizer.py). Every uploaded
# image — citizen report photos and staff resolution photos — is decoded,
# stripped of metadata, resized, and re-encoded before anything else in
# the app uses it. See that module for the full pipeline.
MAX_IMAGE_UPLOAD_MB=10
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_PIXELS=25000000
MAX_STORED_WIDTH=1920
MAX_STORED_HEIGHT=1920
SANITIZED_IMAGE_FORMAT=webp
SANITIZED_IMAGE_QUALITY=85

# Optional antivirus scanning extension point (app/services/antivirus_service.py).
# Requires a local ClamAV daemon + the optional 'clamd' package when true.
# The app works fully with this left false — no AV dependency needed.
ANTIVIRUS_ENABLED=false

# Duplicate candidate pre-filtering (app/services/duplicate_detector.py) —
# narrows which issues are even compared by the canonical duplicate
# engine (app/services/core/duplicate.py, never modified). Purely a
# performance/relevance filter, not a scoring change.
DUPLICATE_CANDIDATE_LOOKBACK_DAYS=60
DUPLICATE_CANDIDATE_MAX_DISTANCE_METERS=500

# Rate limiting / anti-spam (app/services/rate_limiter.py). Applies to
# POST /citizen/reports and the "add support" endpoint. Keyed by the
# citizen's mobile-derived account, not a raw IP — see that module for
# why IP alone is never used to block a shared network.
RATE_LIMIT_ANON_COUNT=5
RATE_LIMIT_AUTH_COUNT=10
RATE_LIMIT_WINDOW_SECONDS=600

# Local dev fallback shown; production must set this via env (Render).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

CITY_NAME=Chennai
CITY_CENTER_LAT=13.0827
CITY_CENTER_LNG=80.2707

# Copy to .env for local dev. For Vercel, set VITE_API_BASE_URL in the
# project's environment variables to your deployed Render backend URL —
# never hardcode a deployed URL in source. Do NOT put API keys here
# (VITE_ vars are bundled into the public client build) — ElevenLabs and
# Groq keys are backend-only, see backend/.env.example.
VITE_API_BASE_URL=http://localhost:8000
